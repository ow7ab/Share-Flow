<?xml version="1.0" encoding="utf-8"?>
<!--
  Defense-in-depth Data Extraction Rules (API 31+):
  Excludes Private Vault encrypted files, Room databases, and DataStore preferences
  from both cloud backup and device-to-device transfer because Android Keystore keys
  are hardware-bound and non-exportable.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
