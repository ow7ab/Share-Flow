<?xml version="1.0" encoding="utf-8"?>
<!--
  Defense-in-depth Auto Backup rules (API 24-30):
  ShareFlow sets android:allowBackup="false" in AndroidManifest.xml.
  These explicit exclusions ensure Private Vault blobs, Room databases,
  and DataStore preferences are never included in cloud backups.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
